PORT=3001
NODE_ENV=production

# MySQL Database
DB_HOST=localhost
DB_USER=fitai_user
DB_PASSWORD=your_mysql_password
DB_NAME=fitai
DB_PORT=3306

# Security
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Google Gemini AI
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins (comma separated)
FRONTEND_URL=https://fitai.novacodex.in,http://localhost:5173

# Gym Management Backend Integration
GYM_MGMT_API_URL=http://localhost:5000/api/v1
FITAI_INTEGRATION_SECRET=fitai-gym-shared-secret-key-change-in-production
